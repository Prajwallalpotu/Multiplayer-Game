PORT=3001
DATABASE_PATH=./data/last-ten.sqlite
# Exact browser origin in production (same origin deployment recommended)
PUBLIC_ORIGIN=
# Short-lived TURN credentials should be issued by your deployment if possible.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# Example including TURN: [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example:3478","username":"user","credential":"secret"}]
# Only enable on a private development machine. Simulated sessions never rank.
ENABLE_DEV_HARNESS=false
